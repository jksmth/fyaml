FROM alpine:3.23@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

ARG TARGETPLATFORM

# Create non-root user
RUN addgroup -S fyaml && adduser -S fyaml -G fyaml

COPY --chown=fyaml:fyaml $TARGETPLATFORM/fyaml /usr/local/bin/fyaml

USER fyaml

ENTRYPOINT ["/usr/local/bin/fyaml"]
